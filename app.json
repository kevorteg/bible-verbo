{
  "expo": {
    "name": "Verbo Bible",
    "slug": "verbo-bible",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "verbo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mj.verbobible"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff8f5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.mj.verbobible"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#449BD1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
